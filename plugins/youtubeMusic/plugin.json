{
  "id": "youtubeMusic",
  "name": "YouTube Music",
  "description": "Guest YouTube Music search and playback.",
  "priority": 75,
  "view": {
    "type": "mediaPlayer",
    "mediaPlayer": {
      "previous": { "label": "Previous", "emoji": "⏮️", "action": "youtubeMusic.prevTrack" },
      "playPause": { "label": "Play", "emoji": "▶️", "action": "youtubeMusic.togglePlay" },
      "next": { "label": "Next", "emoji": "⏭️", "action": "youtubeMusic.nextTrack" },
      "like": { "label": "Like", "emoji": "❤️", "action": "youtubeMusic.like" },
      "shuffle": { "label": "Shuffle", "emoji": "🔀", "action": "youtubeMusic.toggleShuffle" },
      "volumeAction": "youtubeMusic.setVolume",
      "seekAction": "youtubeMusic.seek"
    }
  },
  "layout": {
    "grid": [2, 2],
    "buttons": [
      { "label": "Previous", "emoji": "⏮️", "action": "youtubeMusic.prevTrack" },
      { "label": "Play/Pause", "emoji": "⏯️", "action": "youtubeMusic.togglePlay" },
      { "label": "Next", "emoji": "⏭️", "action": "youtubeMusic.nextTrack" },
      { "label": "Like", "emoji": "❤️", "action": "youtubeMusic.like" }
    ]
  }
}
